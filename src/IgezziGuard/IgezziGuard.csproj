<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HankiTools</AssemblyName>
    <RootNamespace>IgezziGuard</RootNamespace>
    <Version>0.19.0-rc.1</Version>
    <AssemblyVersion>0.19.0.0</AssemblyVersion>
    <FileVersion>0.19.0.0</FileVersion>
    <Product>Hanki Tools</Product>
    <Description>Windows diagnostics, maintenance and performance toolkit</Description>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WFO1000 guards properties the Windows Forms designer would serialize. Hanki builds every control in code and has no
         designer files, so nothing is serialized; annotating each control property would add noise without protection. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <ApplicationIcon>Brand/hanki.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Sizes are written for 100% and scaled once by Dpi.cs to the display scale Windows had when Hanki started. -->
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Brand/hanki.ico" />
    <EmbeddedResource Include="Brand/hanki-smile.png" />
    <Content Include="Data\signatures.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
