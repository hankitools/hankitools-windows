<Window x:Class="IgezziGuard.Shell.Palette" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Find a tool" Width="700" Height="520" MinWidth="520" MinHeight="380"
        Background="{StaticResource Surface}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="15" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip" UseLayoutRounding="True">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource Border}" Background="{StaticResource Canvas}" Padding="12,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE721;" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,0,10,0"/>
                <TextBox x:Name="Query" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextPrimary}" CaretBrush="{StaticResource TextPrimary}"
                         FontSize="16" Height="40" VerticalContentAlignment="Center" AutomationProperties.Name="Search tools"/>
            </DockPanel>
        </Border>
        <ListBox x:Name="Results" Grid.Row="1" Margin="0,12,0,0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}"
                 AutomationProperties.Name="Matching tools" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="12,7"/>
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Frame" CornerRadius="6" Background="Transparent" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource RailHover}"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Frame" Property="Background" Value="{StaticResource RailSelected}"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
        <TextBlock x:Name="Hint" Grid.Row="2" Margin="0,10,0,10" FontSize="13" Foreground="{StaticResource TextMuted}"/>
        <Button x:Name="OpenButton" Grid.Row="3" Style="{StaticResource PrimaryButton}" Content="Open selected tool" IsDefault="True" Height="42"/>
    </Grid>
</Window>
