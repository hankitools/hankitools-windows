<Window x:Class="IgezziGuard.Shell.ShellWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Hanki Tools" Width="1320" Height="880" MinWidth="1120" MinHeight="740"
        Background="{StaticResource Canvas}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="14" UseLayoutRounding="True" SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Pine}" BorderBrush="{StaticResource Hairline}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,12,12,12" LastChildFill="True">
                <StackPanel DockPanel.Dock="Bottom">
                    <StackPanel x:Name="QuickPanel" Visibility="Collapsed" Margin="0,0,0,4"/>
                    <Button x:Name="QuickToggle" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            AutomationProperties.Name="Expand quick access" Content="›  Quick access" FontSize="13" Margin="0,0,0,2"/>
                    <Button x:Name="AboutButton" Style="{StaticResource QuietButton}" HorizontalContentAlignment="Left"
                            Content="About &amp; privacy" FontSize="13"/>
                    <TextBlock x:Name="VersionText" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="12,8,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Margin="8,4,0,0">
                        <Image x:Name="BrandMark" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Hanki Tools" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="A LITTLE SISU FOR YOUR PC" FontSize="10" Foreground="{StaticResource Accent}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="RailItems" Margin="0,4,0,0"/>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,14,22,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Button x:Name="BackButton" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" Visibility="Collapsed"
                            Padding="4,4" FontWeight="SemiBold" FontSize="14"/>
                    <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               AutomationProperties.HeadingLevel="Level1" Margin="0,2,0,0"/>
                </StackPanel>
                <Button x:Name="SearchButton" Grid.Column="1" Style="{StaticResource FieldButton}" Width="270" VerticalAlignment="Bottom"
                        AutomationProperties.Name="Find a tool, Control K">
                    <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE721;" FontSize="14" Margin="0,0,10,0" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock DockPanel.Dock="Left" Text="Find a tool…" Foreground="{StaticResource TextMuted}" FontSize="14"/>
                        <TextBlock DockPanel.Dock="Right" Text="Ctrl+K" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                    </DockPanel>
                </Button>
            </Grid>

            <TextBlock x:Name="IntroText" Grid.Row="1" Margin="24,0,24,12" TextWrapping="Wrap" FontSize="15"
                       Foreground="{StaticResource TextMuted}" AutomationProperties.Name="About this page"/>

            <Border Grid.Row="2" Background="{StaticResource Canvas}">
                <wfi:WindowsFormsHost x:Name="Host" Background="{StaticResource Canvas}"/>
            </Border>

            <Border x:Name="FooterBar" Grid.Row="3" Visibility="Collapsed" Background="{StaticResource Canvas}"
                    BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0" Padding="16,8,12,8">
                <DockPanel LastChildFill="True">
                    <Button x:Name="CancelTasksButton" DockPanel.Dock="Right" Style="{StaticResource QuietButton}" Content="Cancel tasks"
                            Visibility="Collapsed" FontSize="13"/>
                    <TextBlock x:Name="RunningText" DockPanel.Dock="Right" Margin="0,0,12,0" Foreground="{StaticResource TextMuted}" FontSize="13"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource TextMuted}" FontSize="13" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
