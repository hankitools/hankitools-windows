<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hanki.Core</AssemblyName>
    <RootNamespace>IgezziGuard</RootNamespace>
    <Version>0.19.0</Version>
    <AssemblyVersion>0.19.0.0</AssemblyVersion>
    <FileVersion>0.19.0.0</FileVersion>
    <Product>Hanki Tools</Product>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    <EmbeddedResource Include="Localization/Catalogs/*.json" LogicalName="Hanki.Localization.%(Filename).json" />
    <InternalsVisibleTo Include="HankiTools" />
    <InternalsVisibleTo Include="HankiTools.Checks" />
  </ItemGroup>
</Project>
